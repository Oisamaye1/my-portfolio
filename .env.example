# Supabase project URL and publishable (anon) key. Both are safe to expose to the browser;
# row-level security in the database decides who can read and write.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Public address of the site, used for links in the RSS feed, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
